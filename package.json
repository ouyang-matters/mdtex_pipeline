{
  "name": "mdtex-pipeline",
  "version": "0.1.0",
  "description": "Local writing and publishing workspace for Markdown + LaTeX articles: WeChat, Zhihu, PDF and blog",
  "type": "module",
  "main": "src/cli/index.js",
  "bin": {
    "publisher": "./src/cli/index.js"
  },
  "scripts": {
    "start": "node src/cli/index.js start",
    "dev": "vite",
    "build": "vite build",
    "build:bench": "vite build --config vite.bench.config.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e.js",
    "bench": "node scripts/bench-wechat.js",
    "selftest": "node scripts/selftest.js",
    "cli": "node src/cli/index.js",
    "test:workflow": "node scripts/workflow-check.js"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "commander": "^15.0.0",
    "highlight.js": "^11.12.0",
    "juice": "^12.1.2",
    "katex": "^0.18.4",
    "markdown-it": "^15.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-texmath": "^1.0.0",
    "mathjax-full": "^3.2.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.11"
  }
}
