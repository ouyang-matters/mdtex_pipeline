# latexmkrc -- build the MMHM v2 paper:  latexmk -pdf main.tex   (clean: latexmk -c)
# Generated inputs (generated/*.tex, ../figures/*.pdf) are tracked through the
# .fls file once they exist; after they first appear, run latexmk -g once.
$pdf_mode = 1;
$pdflatex = 'pdflatex -interaction=nonstopmode -halt-on-error -file-line-error %O %S';
$bibtex_use = 2;          # run bibtex when refs.bib changes; delete .bbl on clean
@default_files = ('main.tex');
